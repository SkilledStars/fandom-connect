# Public URL configured in your HTTPS reverse proxy. Do not include /admin.
GATEWAY_BASE_URL=https://google-ads-gateway.example.com

# Generate with: openssl rand -base64 32
GATEWAY_MASTER_KEY=REPLACE_WITH_32_BYTE_BASE64_VALUE

# Use at least 16 characters. Store this in your platform's secret manager.
GATEWAY_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Must match the Google Ads API version used by Fandom. Change this setting
# when Google retires an API version; no gateway code change is required.
GATEWAY_GOOGLE_ADS_API_VERSION=v24
